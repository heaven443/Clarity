                                <Label text="Priority" styleClass="task-detail-label" GridPane.columnIndex="6" GridPane.halignment="RIGHT" />
                                <Label text="Normal" styleClass="task-detail-value-normal" GridPane.columnIndex="7" GridPane.halignment="RIGHT" />
                                <Button styleClass="task-status-button-current" text="Current" GridPane.columnIndex="8" GridPane.halignment="RIGHT" />
                            </GridPane>

                            <GridPane styleClass="task-item">
                                <columnConstraints>
                                    <ColumnConstraints minWidth="40.0" prefWidth="40.0" />
                                    <ColumnConstraints hgrow="ALWAYS" minWidth="350.0" prefWidth="350.0" />
