                                    <ColumnConstraints minWidth="50.0" prefWidth="50.0" />
                                    <ColumnConstraints minWidth="60.0" prefWidth="60.0" />
                                    <ColumnConstraints minWidth="80.0" prefWidth="80.0" />
                                </columnConstraints>
