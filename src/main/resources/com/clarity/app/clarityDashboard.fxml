                              <Font name="System Bold" size="11.0" />
                           </font>
                        </Label>
                              <Label fx:id="dateLabel" styleClass="welcome-date" text="September 15, 2025" />
                     </children>
                     <HBox.margin>
                        <Insets left="15.0" />
                     </HBox.margin>
                  </VBox>
               </children>
            </HBox>

                <!-- Stats Cards -->
                <HBox prefHeight="29.0" prefWidth="864.0" spacing="20" styleClass="stats-section">
