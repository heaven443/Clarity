                        <Font name="Arial Bold" size="64.0" />
                     </font>
                     <padding>
                        <Insets left="55.0" top="10.0" />
                     </padding></Label>
                  <HBox.margin>
                     <Insets left="15.0" />
                  </HBox.margin>
                    </VBox>

                    <!-- Overdue Card -->
                    <VBox prefHeight="140.0" prefWidth="151.0" style="-fx-background-radius: 10; -fx-border-color: #EBEBEB; -fx-border-radius: 20; -fx-border-width: 3;" styleClass="stat-card stat-card-red">
                        <Label prefHeight="27.0" prefWidth="117.0" styleClass="stat-label" text="Overdue" textAlignment="CENTER">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                     <padding>
                        <Insets bottom="10.0" left="30.0" />
                     </padding>
                     <font>
                        <Font name="Arial Bold" size="28.0" />
                     </font></Label>
                        <Label fx:id="overdueCount" styleClass="stat-number stat-number-red" text="1" textFill="#ff5e5e">
                     <VBox.margin>
                        <Insets left="37.0" />
                     </VBox.margin>
                     <font>
                        <Font name="Arial Bold" size="64.0" />
                     </font></Label>
                  <padding>
                     <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
                  </padding>
                  <HBox.margin>
                     <Insets left="-10.0" />
                  </HBox.margin>
                    </VBox>
                </HBox>

                <!-- Mini Calendar -->
                <VBox maxHeight="265.0" maxWidth="310.0" minHeight="180.0" minWidth="40.0" prefHeight="265.0" prefWidth="310.0" style="-fx-border-color: #EBEBEB; -fx-border-radius: 20; -fx-border-width: 2;" styleClass="mini-calendar-section">
                    <Label styleClass="section-title" text="SEPTEMBER 2025" textFill="#0000001d">
