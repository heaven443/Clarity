                        <yAxis>
                            <NumberAxis side="LEFT" styleClass="chart-axis" upperBound="25" />
                        </yAxis>
                  <VBox.margin>
                     <Insets left="15.0" />
                  </VBox.margin>
                    </BarChart>
                </VBox>

            </VBox>

        </HBox>
