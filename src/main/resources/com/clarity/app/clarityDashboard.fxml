                            <ColumnConstraints percentWidth="14.285714" />
                            <ColumnConstraints percentWidth="14.285714" />
                            <ColumnConstraints percentWidth="14.285714" />
                            <ColumnConstraints percentWidth="14.285714" />
                            <ColumnConstraints percentWidth="14.285714" />
                        </columnConstraints>
                        <!-- Calendar will be populated by controller -->
                    </GridPane>
               <VBox.margin>
                  <Insets left="15.0" />
               </VBox.margin>
                </VBox>

                <!-- Progress Chart -->
                <VBox prefHeight="334.0" prefWidth="864.0" styleClass="progress-section" VBox.vgrow="ALWAYS">
                    <Label styleClass="section-title" text="Progress" />
                    <BarChart fx:id="progressChart" prefHeight="189.0" prefWidth="487.0" styleClass="progress-chart" VBox.vgrow="ALWAYS">
