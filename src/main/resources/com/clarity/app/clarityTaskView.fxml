<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="800.0" prefWidth="1200.0" stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.clarity.app.ClarityTaskController">
    <left>
        <VBox alignment="TOP_CENTER" prefHeight="800.0" prefWidth="250.0" styleClass="sidebar" stylesheets="@style.css">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="100.0" prefWidth="200.0" stylesheets="@style.css">
                    <children>
                        <Label styleClass="logo-icon" text="✓" />
                        <Label styleClass="logo-text" text="Clarity" />
                    </children>
                    <padding>
                        <Insets left="20.0" />
                    </padding>
                </HBox>
                <VBox spacing="5.0" stylesheets="@style.css">
                    <children>
                        <Label styleClass="sidebar-heading" stylesheets="@style.css" text="Overview" />
                        <Button styleClass="nav-button" stylesheets="@style.css" text="Dashboard" />
                        <Button styleClass="nav-button-active" stylesheets="@style.css" text="My Task" />
                        <Button styleClass="nav-button" text="Notes" />
                        <Button styleClass="nav-button" text="Schedule" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </VBox>

                <VBox stylesheets="@style.css" VBox.vgrow="ALWAYS" />
                <VBox spacing="5.0" stylesheets="@style.css">
                    <children>
                        <Label styleClass="sidebar-heading" stylesheets="@style.css" text="Pinned" />
                    </children>
                    <padding>
                        <Insets left="20.0" right="20.0" />
                    </padding>
                </VBox>
                <VBox stylesheets="@style.css" VBox.vgrow="ALWAYS" />
                <VBox spacing="10.0">
                    <children>
                        <Button fx:id="handleSettingsButton" onAction="#handleSettingsClick" styleClass="nav-button-bottom" stylesheets="@style.css" text="Settings" />
                        <Button styleClass="nav-button-bottom" text="Help &amp; Support" />
                        <Button styleClass="nav-button-bottom" text="Logout" />
                    </children>
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" />
                    </padding>
                </VBox>
            </children>
        </VBox>
    </left>
    <center>
        <VBox styleClass="content-area" stylesheets="@style.css">
            <padding>
                <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="60.0" prefWidth="200.0" spacing="10.0">
                    <children>
                        <MenuButton styleClass="status-dropdown" stylesheets="@style.css" text="Current">
                            <items>
                                <MenuItem text="Completed" />
                                <MenuItem text="All Tasks" />
                            </items>
                        </MenuButton>

                        <HBox HBox.hgrow="ALWAYS" />
                        <Button styleClass="add-task-button" stylesheets="@style.css" text="Add Task" />
                        <Button styleClass="icon-button" stylesheets="@style.css" text="🔔" />
                        <Button styleClass="icon-button" stylesheets="@style.css" text="👤" />
                        <Button styleClass="icon-button" stylesheets="@style.css" text="⚙️" />
                    </children>
                </HBox>


                <ScrollPane fitToWidth="true" styleClass="task-scroll-pane" stylesheets="@style.css" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="taskListContainer" spacing="10.0" styleClass="task-list-container">
                            <HBox minHeight="-Infinity" minWidth="-Infinity" styleClass="task-item" VBox.vgrow="ALWAYS">
                                <CheckBox HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets right="10.0" />
                           </padding></CheckBox>
                                <Label minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="task-label" text="Conduct keyword research for target pages" HBox.hgrow="ALWAYS">
                                    <HBox.margin>
                                        <Insets />
                                    </HBox.margin>
                                    <padding>
                                        <Insets right="70.0" />
                                    </padding></Label>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100.0" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="task-detail-label" text="Due Date" />
                                    <Label styleClass="task-detail-value" text="Sept 13" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Time Est" />
                                    <Label styleClass="task-detail-value" text="3h" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Priority" />
                                    <Label styleClass="task-detail-value-normal" text="Normal" />
                           <HBox.margin>
                              <Insets right="30.0" />
                           </HBox.margin>
                                </VBox>
                                <Button alignment="CENTER_RIGHT" contentDisplay="RIGHT" pickOnBounds="false" prefWidth="100" styleClass="task-status-button-current" text="Current" textAlignment="CENTER" HBox.hgrow="NEVER" />
                            </HBox>

                            <HBox styleClass="task-item" VBox.vgrow="ALWAYS">
                                <CheckBox HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets right="10.0" />
                           </padding></CheckBox>
                                <Label minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="task-label" text="Identifying Target Keywords" HBox.hgrow="ALWAYS">
                                    <HBox.margin>
                                        <Insets />
                                    </HBox.margin>
                                    <padding>
                                        <Insets right="70.0" />
                                    </padding></Label>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="task-detail-label" text="Due Date" />
                                    <Label styleClass="task-detail-value" text="Sept 13" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Time Est" />
                                    <Label styleClass="task-detail-value" text="30min" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Priority" />
                                    <Label styleClass="task-detail-value-normal" text="Normal" />
                           <HBox.margin>
                              <Insets right="30.0" />
                           </HBox.margin>
                                </VBox>
                                <Button alignment="CENTER_RIGHT" contentDisplay="RIGHT" pickOnBounds="false" prefWidth="100" styleClass="task-status-button-current" text="Current" textAlignment="CENTER" HBox.hgrow="NEVER">
                                    <opaqueInsets>
                                        <Insets />
                                    </opaqueInsets>
                                </Button>
                            </HBox>

                            <HBox styleClass="task-item" VBox.vgrow="ALWAYS">
                                <CheckBox HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets right="10.0" />
                           </padding></CheckBox>
                                <Label minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="task-label" text="Update keyword tracking list" HBox.hgrow="ALWAYS">
                                    <HBox.margin>
                                        <Insets />
                                    </HBox.margin>
                                    <padding>
                                        <Insets right="70.0" />
                                    </padding></Label>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="task-detail-label" text="Due Date" />
                                    <Label styleClass="task-detail-value" text="Sept 14" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Time Est" />
                                    <Label styleClass="task-detail-value" text="1h" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Priority" />
                                    <Label styleClass="task-detail-value-low" text="Low" />
                           <HBox.margin>
                              <Insets right="30.0" />
                           </HBox.margin>
                                </VBox>
                                <Button alignment="CENTER_RIGHT" contentDisplay="RIGHT" pickOnBounds="false" prefWidth="100" styleClass="task-status-button-current" text="Current" textAlignment="CENTER" HBox.hgrow="NEVER" />
                            </HBox>

                            <HBox styleClass="task-item" VBox.vgrow="ALWAYS">
                                <CheckBox HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets right="10.0" />
                           </padding></CheckBox>
                                <Label minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="task-label" text="Identify low-hanging fruit keywords" HBox.hgrow="ALWAYS">
                                    <HBox.margin>
                                        <Insets />
                                    </HBox.margin>
                                    <padding>
                                        <Insets right="70.0" />
                                    </padding></Label>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="task-detail-label" text="Due Date" />
                                    <Label styleClass="task-detail-value" text="Sept 14" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Time Est" />
                                    <Label styleClass="task-detail-value" text="1h" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Priority" />
                                    <Label styleClass="task-detail-value-low" text="Low" />
                           <HBox.margin>
                              <Insets right="30.0" />
                           </HBox.margin>
                                </VBox>
                                <Button alignment="CENTER_RIGHT" contentDisplay="RIGHT" pickOnBounds="false" prefWidth="100.0" styleClass="task-status-button-current" text="Current" textAlignment="CENTER" HBox.hgrow="NEVER" />
                            </HBox>

                            <HBox styleClass="task-item" VBox.vgrow="ALWAYS">
                                <CheckBox HBox.hgrow="ALWAYS">
                           <HBox.margin>
                              <Insets />
                           </HBox.margin>
                           <padding>
                              <Insets right="10.0" />
                           </padding></CheckBox>
                                <Label minHeight="-Infinity" minWidth="-Infinity" prefWidth="400.0" styleClass="task-label" text="Analyze competitors' keyword strategy" HBox.hgrow="ALWAYS">
                                    <HBox.margin>
                                        <Insets />
                                    </HBox.margin>
                                    <padding>
                                        <Insets right="70.0" />
                                    </padding></Label>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="ALWAYS">
                                    <Label styleClass="task-detail-label" text="Due Date" />
                                    <Label styleClass="task-detail-value" text="Sept 14" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Time Est" />
                                    <Label styleClass="task-detail-value" text="2h" />
                                </VBox>
                                <VBox alignment="CENTER_RIGHT" prefWidth="100" spacing="2.0" HBox.hgrow="NEVER"> <Label styleClass="task-detail-label" text="Priority" />
                                    <Label styleClass="task-detail-value-low" text="Low" />
                           <HBox.margin>
                              <Insets right="30.0" />
                           </HBox.margin>
                                </VBox>
                                <Button alignment="CENTER_RIGHT" contentDisplay="RIGHT" pickOnBounds="false" prefWidth="100.0" styleClass="task-status-button-current" text="Current" textAlignment="CENTER" HBox.hgrow="NEVER" />
                            </HBox>
                        </VBox>
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </center>
</BorderPane>
